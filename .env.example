# === Bridge settings ===

# Required: set this to the verify token you configure in Meta Developer Console
WA_VERIFY_TOKEN=your-secret-verify-token

# Where to store incoming messages (JSONL format, one message per line)
WA_INBOX=./inbox/messages.jsonl

# Port the bridge listens on
WA_PORT=3100

# Webhook path (must match what you register with Meta)
WA_WEBHOOK_PATH=/webhook

# === Telegram digest (optional) ===

# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Get your chat ID via @userinfobot or @getidsbot
TELEGRAM_CHAT_ID=your-chat-id

# === API server (optional, examples/api-server.py) ===
API_PORT=3101
